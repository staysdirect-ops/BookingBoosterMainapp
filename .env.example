# Bookingbooster server settings. Copy to .env and fill in what you have.
# Anything left blank runs in test mode: messages stay in the outbox table and card payments are off.

PORT=8080
BASE_URL=https://booking-booster.co.uk
DATA_DIR=./data
# A long random string. Signs sessions and guest links. Generated into DATA_DIR/.secret if blank.
APP_SECRET=
# Free site addresses, e.g. harbour-view.bookingbooster.site (point a wildcard DNS record at this server)
SITES_DOMAIN=
# Hosts' own domains: what they point www at (defaults to the BASE_URL host) and this server's IPv4 addresses for the bare domain
CUSTOM_DOMAIN_TARGET=
CUSTOM_DOMAIN_IPS=
# On Fly.io: lets the app add a certificate for each host domain once it is proved
FLY_API_TOKEN=
FLY_APP_NAME=
# Buying new domains for hosts at sign-up, through your 20i reseller account (leave blank to turn it off).
# General API key from my.20i.com > Reseller Preferences > API. Fees come out of your prepaid 20i balance.
TWENTYI_API_KEY=
# The 20i hosting package that serves booking-booster.co.uk. New domains are added to it, with 20i's free SSL.
# Leave blank when the app runs elsewhere (Fly.io): we then write A and CNAME records to CUSTOM_DOMAIN_IPS / _TARGET instead.
TWENTYI_PACKAGE_ID=
# Endings we register (each costs roughly £5 to £12 a year at reseller prices), and how many new domains an account gets
DOMAIN_TLDS=co.uk,uk,com
DOMAINS_PER_ACCOUNT=1
# included: the plan pays for renewals. charge: add DOMAIN_RENEWAL_PRICE (pounds) to the host's next invoice each year
DOMAIN_RENEWAL=included
DOMAIN_RENEWAL_PRICE=
# 1 adds WHOIS privacy on non-.uk names (an extra 20i charge). .uk names for individuals are kept private by Nominet anyway
DOMAIN_PRIVACY=
# Daily database copies kept in DATA_DIR/backups
BACKUP_KEEP=14

# Company details shown in email footers and legal pages
COMPANY_NAME=Bookingbooster Ltd
COMPANY_ADDRESS=
COMPANY_NUMBER=
VAT_NUMBER=
# The date a solicitor signed off /privacy and /terms (YYYY-MM-DD). Until set, both pages say Draft.
LEGAL_REVIEWED=
SUPPORT_EMAIL=help@booking-booster.co.uk
# Team members who can see leads and accounts at /admin (comma separated)
ADMIN_EMAILS=
# Lead follow-up emails: who they come from (defaults to EMAIL_FROM) and how they are signed
LEADS_FROM=
LEADS_SIGNOFF=The Bookingbooster team

# Email: set one of these
RESEND_API_KEY=
POSTMARK_TOKEN=
EMAIL_FROM=Bookingbooster <hello@booking-booster.co.uk>
# Domain guest emails are sent from (bookings@<this>), with replies going to the host
GUEST_EMAIL_DOMAIN=mail.booking-booster.co.uk

# Text messages (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Stripe: Connect (hosts get paid directly), Checkout, and host subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_CALENDAR_SYNC=
# Yearly billing (the pricing page offers it): npm run stripe-setup creates these too
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_CALENDAR_SYNC_ANNUAL=
STRIPE_PRICE_ALL_CHANNELS=
STRIPE_PRICE_ALL_CHANNELS_ANNUAL=
# Signing secret of the Connect webhook (hosts' account.updated events)
STRIPE_CONNECT_WEBHOOK_SECRET=
# Guest card fees: Stripe takes them from us on every guest payment, so they are passed to the host at cost.
# STRIPE_PASS_CARD_FEES=0 turns this off. Rate defaults: 1.5% + 20p (standard UK cards).
STRIPE_PASS_CARD_FEES=
STRIPE_CARD_FEE_PCT=
STRIPE_CARD_FEE_PENCE=
# Optional platform fee on each booking, in percent. Leave 0 for no commission.
STRIPE_APPLICATION_FEE_PCT=0

# AI visibility checks (any you have; each one adds an engine)
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
SERPAPI_KEY=

# Google Search Console for every host site, with no host login: a Google Cloud service account key (JSON, or the
# same base64-encoded) with the Site Verification API and Search Console API enabled. We verify each site with a meta
# tag we serve, submit its sitemap daily and read back clicks and top searches. Leave empty to switch off.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Claude drafts replies to guest messages in the inbox
ANTHROPIC_API_KEY=
# Site builder and funnel creator (AI art director). Opus gives the best design and copy.
ANTHROPIC_STUDIO_MODEL=claude-opus-5-5
ANTHROPIC_STUDIO_EFFORT=medium
ANTHROPIC_MODEL=claude-sonnet-5-5
# Event ads (Grow -> Event ads): finds events, training courses and conferences near each home that last 2+ days.
# No event APIs or keys: our own finder (server/studio/crawler.js) reads public what's-on, venue and course pages and
# calendar feeds in the background, following each site's robots.txt. Starter pages are in server/studio/event-sources.json.
# EVENT_CRAWL=off stops the background reading. EVENT_SEEDS=off skips the starter pages (or give a path to another list).
# EVENT_CRAWL=
# AI credit (server/credits.js). Each plan includes this much AI use a month, in pounds; it resets each billing month.
# AI actions are charged at token cost × AI_CREDIT_MARKUP (1 = at cost). Hosts top up from £10 to £20,000 in Plan and billing.
# AI_CREDITS=off
AI_CREDIT_MONTHLY=50
# Credit for each demo workspace (hosts who have not paid, or have cancelled, get no monthly allowance)
AI_CREDIT_DEMO=1
AI_CREDIT_MARKUP=1
# Model prices are in US dollars; this turns them into pounds
AI_USD_TO_GBP=0.79

# How often calendar links are checked, in minutes
ICAL_SYNC_MINUTES=10

# Partner programme (/partners): one-off bonus per referred host in pounds (capped at 50), how long a referral link is remembered,
# how long commission is held before it can be paid (for refunds), and the smallest payout in pounds
AFFILIATE_BONUS=50
AFFILIATE_COOKIE_DAYS=90
AFFILIATE_HOLD_DAYS=30
AFFILIATE_MIN_PAYOUT=50

# All channels (server/channex.js): Bookingbooster's own Channex account lists hosts' homes on Airbnb, Booking.com,
# Vrbo and 70+ more. Staging first; switch CHANNEX_BASE to https://app.channex.io after Channex certifies us.
# It only switches on once CHANNEX_MIN_HOSTS hosts pay for the add-on (enough to cover Channex's monthly fee).
CHANNEX_API_KEY=
CHANNEX_BASE=https://staging.channex.io
CHANNEX_MIN_HOSTS=9
CHANNEX_ALWAYS_ON=
CHANNEX_WEBHOOK_SECRET=
