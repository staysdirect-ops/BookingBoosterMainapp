# Bookingbooster server settings. Copy to .env and fill in what you have.
# Anything left blank runs in test mode: messages stay in the outbox table and card payments are off.

PORT=8080
BASE_URL=https://booking-booster.co.uk
DATA_DIR=./data
# A long random string. Signs sessions and guest links. Generated into DATA_DIR/.secret if blank.
APP_SECRET=
# Free site addresses, e.g. harbour-view.bookingbooster.site (point a wildcard DNS record at this server)
SITES_DOMAIN=
# Hosts' own domains: what they point www at (defaults to the BASE_URL host) and this server's IPv4 addresses for the bare domain
CUSTOM_DOMAIN_TARGET=
CUSTOM_DOMAIN_IPS=
# On Fly.io: lets the app add a certificate for each host domain once it is proved
FLY_API_TOKEN=
FLY_APP_NAME=
# Daily database copies kept in DATA_DIR/backups
BACKUP_KEEP=14

# Company details shown in email footers and legal pages
COMPANY_NAME=Bookingbooster Ltd
COMPANY_ADDRESS=
COMPANY_NUMBER=
VAT_NUMBER=
# The date a solicitor signed off /privacy and /terms (YYYY-MM-DD). Until set, both pages say Draft.
LEGAL_REVIEWED=
SUPPORT_EMAIL=help@booking-booster.co.uk
# Team members who can see leads and accounts at /admin (comma separated)
ADMIN_EMAILS=
# Lead follow-up emails: who they come from (defaults to EMAIL_FROM) and how they are signed
LEADS_FROM=
LEADS_SIGNOFF=The Bookingbooster team

# Email: set one of these
RESEND_API_KEY=
POSTMARK_TOKEN=
EMAIL_FROM=Bookingbooster <hello@booking-booster.co.uk>
# Domain guest emails are sent from (bookings@<this>), with replies going to the host
GUEST_EMAIL_DOMAIN=mail.booking-booster.co.uk

# Text messages (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Stripe: Connect (hosts get paid directly), Checkout, and host subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GROWTH=
# One-off £997 setup fee, charged at checkout (the first month is free)
STRIPE_PRICE_SETUP=
STRIPE_PRICE_CALENDAR_SYNC=
# Yearly billing (the pricing page offers it): npm run stripe-setup creates these too
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_CALENDAR_SYNC_ANNUAL=
# Signing secret of the Connect webhook (hosts' account.updated events)
STRIPE_CONNECT_WEBHOOK_SECRET=
# Optional platform fee on each booking, in percent. Leave 0 for no commission.
STRIPE_APPLICATION_FEE_PCT=0

# AI visibility checks (any you have; each one adds an engine)
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
SERPAPI_KEY=
# Claude drafts replies to guest messages in the inbox
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# How often calendar links are checked, in minutes
ICAL_SYNC_MINUTES=15
